+// "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+// KIND, either express or implied.  See the License for the
+// specific language governing permissions and limitations
+// under the License.
+
+// tparquet fork: the PCODEC Parquet codec (tparquet spec/FORMAT.md) over the tparquet
+// C ABI (rust/capi, tparquet.h). One-shot only: a PCODEC page payload is decoded with the
+// exact decompressed size, so Decompress() requires output_buffer_len to be that size.
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "arrow/result.h"
+#include "arrow/status.h"
+#include "arrow/util/compression_internal.h"
+
+#include "tparquet.h"
+
+namespace arrow {
+namespace util {
+namespace internal {
+
+namespace {
+
+constexpr int kPcodecMinimumCompressionLevel = 0;
+constexpr int kPcodecMaximumCompressionLevel = 12;
+
+Status PcodecError(int32_t code, const char* what) {
+  char message[512];
+  pcp_last_error(message, sizeof(message));
+  if (code == PCP_ERR_ARGUMENT) {
+    return Status::Invalid(what, message);
+  }
+  return Status::IOError(what, message);
+}
+
+class PcodecCodec final : public Codec {
+ public:
+  PcodecCodec(int compression_level, int physical_type, bool decimal)
+      : compression_level_(compression_level == kUseDefaultCompressionLevel
+                               ? kPcodecDefaultCompressionLevel
+                               : compression_level),
+        physical_type_(physical_type),
+        decimal_(decimal) {}
+
+  Result<int64_t> Decompress(int64_t input_len, const uint8_t* input,
+                             int64_t output_buffer_len, uint8_t* output_buffer) override {
+    if (input_len < 0 || output_buffer_len < 0) {
+      return Status::Invalid("pcodec decompress: negative length");
+    }
+    const int32_t code =
+        pcp_decompress(input, static_cast<size_t>(input_len), output_buffer,
+                       static_cast<size_t>(output_buffer_len));
+    if (code != PCP_OK) {
+      return PcodecError(code, "pcodec decompress failed: ");
+    }
+    return output_buffer_len;
+  }
+
+  Result<int64_t> Compress(int64_t input_len, const uint8_t* input,
+                           int64_t output_buffer_len, uint8_t* output_buffer) override {
+    if (input_len < 0 || output_buffer_len < 0) {
+      return Status::Invalid("pcodec compress: negative length");
+    }
+    size_t written = 0;
+    const int32_t code = pcp_compress(
+        input, static_cast<size_t>(input_len), physical_type_, compression_level_,
+        decimal_ ? 1 : 0, output_buffer, static_cast<size_t>(output_buffer_len), &written);
+    if (code != PCP_OK) {
+      return PcodecError(code, "pcodec compress failed: ");
+    }
+    return static_cast<int64_t>(written);
+  }
+
+  int64_t MaxCompressedLen(int64_t input_len,
+                           const uint8_t* /*input*/) override {
+    return static_cast<int64_t>(pcp_compress_bound(static_cast<size_t>(input_len)));
+  }
+
+  Result<std::shared_ptr<Compressor>> MakeCompressor() override {
+    return Status::NotImplemented("Streaming compression unsupported with pcodec");
+  }
+
+  Result<std::shared_ptr<Decompressor>> MakeDecompressor() override {
+    return Status::NotImplemented("Streaming decompression unsupported with pcodec");
+  }
+
+  Compression::type compression_type() const override { return Compression::PCODEC; }
+
+  int compression_level() const override { return compression_level_; }
+  int minimum_compression_level() const override {
+    return kPcodecMinimumCompressionLevel;
+  }
+  int maximum_compression_level() const override {
+    return kPcodecMaximumCompressionLevel;
+  }
+  int default_compression_level() const override {
+    return kPcodecDefaultCompressionLevel;
+  }
+
+ private:
+  Status Init() override {
+    if (compression_level_ < kPcodecMinimumCompressionLevel ||
+        compression_level_ > kPcodecMaximumCompressionLevel) {
+      return Status::Invalid("pcodec compression level ", compression_level_,
+                             " not in 0..12");
+    }
+    return Status::OK();
+  }
+
+  const int compression_level_;
+  const int physical_type_;
+  const bool decimal_;
+};
+
+}  // namespace
+
+std::unique_ptr<Codec> MakePcodecCodec(int compression_level, int physical_type,
+                                       bool decimal) {
+  return std::make_unique<PcodecCodec>(compression_level, physical_type, decimal);
+}
+
+}  // namespace internal
+}  // namespace util
+}  // namespace arrow
