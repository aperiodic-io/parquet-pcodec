+// tparquet fork: a file with a PCODEC column chunk gets parquet.pcodec.version = "1"
+// (tparquet spec/FORMAT.md section 2), unless the key is already there.
+std::shared_ptr<const KeyValueMetadata> WithPcodecVersion(
+    const std::vector<format::RowGroup>& row_groups,
+    const std::shared_ptr<const KeyValueMetadata>& key_value_metadata) {
+  static const std::string kKey = "parquet.pcodec.version";
+  bool has_pcodec = false;
+  for (const auto& row_group : row_groups) {
+    for (const auto& column : row_group.columns) {
+      has_pcodec |= column.meta_data.codec == format::CompressionCodec::PCODEC;
+    }
+  }
+  if (!has_pcodec || (key_value_metadata && key_value_metadata->Contains(kKey))) {
+    return key_value_metadata;
+  }
+  auto with_key = key_value_metadata ? key_value_metadata->Copy()
+                                     : std::make_shared<KeyValueMetadata>();
+  with_key->Append(kKey, "1");
+  return with_key;
+}
+
 }  // namespace
 
