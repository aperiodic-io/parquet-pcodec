# name: tests/sql/read.test
# description: read_pparquet over the conformance vectors
require pparquet

query I
SELECT count(*) FROM read_pparquet('__TESTDATA__/primitives_required.parquet')
----
3000

query IIRR
SELECT i32, i64, f32, f64 FROM read_pparquet('__TESTDATA__/primitives_required.parquet') ORDER BY i64 LIMIT 2
----
-500	1000000000839	-50.0	753.679
-463	1000000001588	-49.75	349.814

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_pparquet('__TESTDATA__/temporal.parquet'))
----
ts_ms_utc	TIMESTAMP WITH TIME ZONE
ts_us	TIMESTAMP
ts_ns_utc	TIMESTAMPTZ_NS
ts_ms_ny	TIMESTAMP WITH TIME ZONE
date32	DATE
time64_us	TIME
dec18_4	DECIMAL(18,4)
dec9_2	DECIMAL(9,2)

query TTT
SELECT ts_ns_utc::VARCHAR, dec18_4::VARCHAR, dec9_2::VARCHAR FROM read_pparquet('__TESTDATA__/temporal.parquet') ORDER BY ts_us LIMIT 2
----
2025-01-01 00:00:00+00	123.4500	-500.00
2025-01-01 00:00:00.007000001+00	123.4525	-499.97

query II
SELECT count(*), count(ints) FROM read_pparquet('__TESTDATA__/lists.parquet')
----
1200	1066

query I
SELECT sum(len(ints)) FROM read_pparquet('__TESTDATA__/lists.parquet')
----
2325

query RI
SELECT book.quote.bid, book.tags[1] FROM read_pparquet('__TESTDATA__/nested_struct.parquet') WHERE book.id = 2
----
1003.0	0

query TI
SELECT symbol, count(*) FROM read_pparquet('__TESTDATA__/mixed.parquet') GROUP BY symbol ORDER BY symbol
----
ADA-USD	380
BTC-USD	332
ETH-USD	395
SOL-USD	393

query I
SELECT count(*) FROM read_pparquet('__TESTDATA__/*.parquet', union_by_name := true)
----
22900

query II
SELECT count(DISTINCT filename), max(file_row_number) FROM read_pparquet(['__TESTDATA__/mixed.parquet', '__TESTDATA__/mixed.parquet'], filename := true, file_row_number := true)
----
1	1499
