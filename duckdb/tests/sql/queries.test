# name: tests/sql/queries.test
# description: query shapes over read_tparquet
require tparquet

statement ok
SET threads = 4

statement ok
COPY (SELECT i AS id, i % 7 AS k, CASE WHEN i % 5 = 0 THEN NULL ELSE i * 0.5 END::DOUBLE AS x, {'a': i, 'l': [i, NULL]} AS st FROM range(100000) r(i)) TO '__TEST_DIR__/q.parquet' (FORMAT tparquet, COLUMN_NAMES ['id', 'k', 'x', 'st'], ROW_GROUP_ROWS 3000)

query I
SELECT count(*) FROM read_tparquet('__TEST_DIR__/q.parquet')
----
100000

query I
SELECT id FROM read_tparquet('__TEST_DIR__/q.parquet') ORDER BY id LIMIT 3 OFFSET 99998
----
99998
99999

query I
SELECT count(*) FROM (SELECT * FROM read_tparquet('__TEST_DIR__/q.parquet') LIMIT 2049)
----
2049

query IIR
SELECT k, count(*), sum(x) FROM read_tparquet('__TEST_DIR__/q.parquet') WHERE k IN (1, 6) GROUP BY k ORDER BY k
----
1	14286	285721428.0
6	14285	285700000.0

query II
SELECT count(*), count(x) FROM read_tparquet('__TEST_DIR__/q.parquet') WHERE x IS NULL
----
20000	0

query II
SELECT st.a, st.l[1] FROM read_tparquet('__TEST_DIR__/q.parquet') WHERE st.a = 77777
----
77777	77777

query III
SELECT x, k, id FROM read_tparquet('__TEST_DIR__/q.parquet') WHERE id = 3
----
1.5	3	3

query I
SELECT count(*) FROM read_tparquet('__TEST_DIR__/q.parquet') a JOIN read_tparquet('__TEST_DIR__/q.parquet') b ON a.id = b.id + 1
----
99999

query I
SELECT count(DISTINCT id) FROM read_tparquet('__TEST_DIR__/q.parquet', file_row_number := true) WHERE id = file_row_number
----
100000

# a view and a CTE over the scan
statement ok
CREATE VIEW v AS SELECT * FROM read_tparquet('__TEST_DIR__/q.parquet')

query II
WITH c AS (SELECT k, max(id) AS m FROM v GROUP BY k) SELECT min(m), max(m) FROM c
----
99993	99999

# the extension loaded twice: the functions are still there and work
statement ok
LOAD '__EXTENSION__'

query I
SELECT count(*) FROM read_tparquet('__TEST_DIR__/q.parquet') WHERE k = 0
----
14286
