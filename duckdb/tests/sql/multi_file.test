# name: tests/sql/multi_file.test
# description: globs, lists of files, union_by_name, filename and file_row_number
require tparquet

statement ok
COPY (SELECT i AS id, 'a' || i AS s FROM range(10) r(i)) TO '__TEST_DIR__/a1.parquet' (FORMAT tparquet, COLUMN_NAMES ['id', 's'])

statement ok
COPY (SELECT i + 10 AS id, 'b' || i AS s FROM range(5) r(i)) TO '__TEST_DIR__/a2.parquet' (FORMAT tparquet, COLUMN_NAMES ['ID', 'S'], ROW_GROUP_ROWS 2)

statement ok
COPY (SELECT i + 100 AS id, i * 0.5 AS extra FROM range(3) r(i)) TO '__TEST_DIR__/b1.parquet' (FORMAT tparquet, COLUMN_NAMES ['id', 'extra'])

query II
SELECT count(*), sum(id) FROM read_tparquet('__TEST_DIR__/a*.parquet')
----
15	105

# a list mixes files and globs, in the order given; a file may come twice
query II
SELECT count(*), count(DISTINCT filename) FROM read_tparquet(['__TEST_DIR__/a2.parquet', '__TEST_DIR__/a?.parquet'], filename := true)
----
20	2

# names match ignoring case; the first file names the columns
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tparquet('__TEST_DIR__/a*.parquet'))
----
id	BIGINT
s	VARCHAR

statement error
SELECT * FROM read_tparquet('__TEST_DIR__/*.parquet')
----
the files must have the same schema, or pass union_by_name := true

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tparquet('__TEST_DIR__/*.parquet', union_by_name := true))
----
id	BIGINT
s	VARCHAR
extra	DECIMAL(21,1)

query IIII
SELECT count(*), count(s), count(extra), sum(id) FROM read_tparquet('__TEST_DIR__/*.parquet', union_by_name := true)
----
18	15	3	408

query TII
SELECT regexp_extract(filename, '[ab][12]'), min(file_row_number), max(file_row_number) FROM read_tparquet('__TEST_DIR__/*.parquet', union_by_name := true, filename := true, file_row_number := true) GROUP BY ALL ORDER BY 1
----
a1	0	9
a2	0	4
b1	0	2

query IT
SELECT file_row_number, s FROM read_tparquet('__TEST_DIR__/a2.parquet', file_row_number := true) WHERE file_row_number BETWEEN 1 AND 3 ORDER BY 1
----
1	b1
2	b2
3	b3

statement error
SELECT * FROM read_tparquet(['__TEST_DIR__/a1.parquet', '__TEST_DIR__/nothing*.parquet'])
----
no files match

statement error
SELECT * FROM read_tparquet('__TEST_DIR__/a1.parquet', hive_partitioning := true)
----
Invalid named parameter "hive_partitioning"

statement error
SELECT * FROM read_tparquet('__TEST_DIR__/a1.parquet', filename := 'name')
----
Could not convert string 'name' to BOOL

statement error
SELECT * FROM read_tparquet()
----
read_tparquet

statement error
SELECT * FROM read_tparquet('__TEST_DIR__/a1.parquet', union_by_name := 1, union_by_name := 0)
----
read_tparquet
