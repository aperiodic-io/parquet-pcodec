# name: tests/sql/options.test
# description: COPY (FORMAT tparquet) options and their errors
require tparquet

statement ok
CREATE TABLE t AS SELECT i AS a, i * 0.25 AS b, 'x' || i AS c FROM range(3000) r(i)

statement ok
COPY t TO '__TEST_DIR__/t.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], POLICY 'pcodec', LEVEL 12, COMPRESSION 'snappy', ROW_GROUP_ROWS 1000, COLUMN_POLICY ['b=base'])

query II
SELECT count(*), sum(a) FROM read_tparquet('__TEST_DIR__/t.parquet')
----
3000	4498500

query I
SELECT count(*) FROM (SELECT * FROM t EXCEPT ALL SELECT * FROM read_tparquet('__TEST_DIR__/t.parquet'))
----
0

# DuckDB keeps ROW_GROUP_SIZE for its generic COPY and accepts it without passing it on
statement ok
COPY t TO '__TEST_DIR__/u.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], ROW_GROUP_SIZE 10)

query I
SELECT count(*) FROM read_tparquet('__TEST_DIR__/u.parquet')
----
3000

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], LEVEL 13)
----
invalid LEVEL 13: expected 0 to 12

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], ROW_GROUP_ROWS 0)
----
ROW_GROUP_ROWS must be a positive number of rows

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], COMPRESSION 'lzo')
----
unknown COMPRESSION "lzo": expected zstd, snappy, gzip, brotli, lz4 or uncompressed

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], COMPRESSION 'snappy', COMPRESSION_LEVEL 3)
----
COMPRESSION 'snappy' takes no COMPRESSION_LEVEL

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], COLUMN_POLICY ['b'])
----
COLUMN_POLICY: expected NAME=policy

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], COLUMN_POLICY ['z=pcodec'])
----
no column named "z"

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b'])
----
COLUMN_NAMES has 2 names but the query has 3 columns

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'a'])
----
COLUMN_NAMES: "a" appears twice

statement error
COPY t TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], SPEED 'fast')
----
unknown option SPEED for FORMAT tparquet; the options are COLUMN_NAMES, POLICY, LEVEL, COLUMN_POLICY, COMPRESSION, COMPRESSION_LEVEL, ROW_GROUP_ROWS

statement error
COPY t TO '/no/such/dir/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'])
----
cannot create /no/such/dir/x.parquet

# zero rows: a file with the columns and no row group
statement ok
COPY (SELECT * FROM t WHERE false) TO '__TEST_DIR__/empty.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'])

query II
SELECT count(*), count(a) FROM read_tparquet('__TEST_DIR__/empty.parquet')
----
0	0

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tparquet('__TEST_DIR__/empty.parquet'))
----
a	BIGINT
b	DECIMAL(22,2)
c	VARCHAR

# the extension's files are standard Parquet when no column uses PCODEC
statement ok
COPY t TO '__TEST_DIR__/base.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'], POLICY 'base')

query I
SELECT count(*) FROM (SELECT * FROM read_parquet('__TEST_DIR__/base.parquet') EXCEPT ALL SELECT * FROM t)
----
0

statement error
SELECT * FROM read_parquet('__TEST_DIR__/t.parquet')
----
Invalid data
