# name: tests/sql/types.test
# description: the DuckDB type of every Parquet type, and every DuckDB type COPY writes or refuses
require tparquet

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tparquet('__TESTDATA__/nested_struct.parquet'))
----
book	STRUCT(id INTEGER, "quote" STRUCT(bid DOUBLE, ask DOUBLE, size BIGINT), tags INTEGER[])

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tparquet('__TESTDATA__/lists.parquet'))
----
ints	BIGINT[]
levels	DOUBLE[]

statement ok
CREATE TABLE t AS SELECT 1::TINYINT AS i8, 2::SMALLINT AS i16, 3::INTEGER AS i32, 4::BIGINT AS i64, 5::UTINYINT AS u8, 6::USMALLINT AS u16, 7::UINTEGER AS u32, 8::UBIGINT AS u64, 1.5::FLOAT AS f, 2.5::DOUBLE AS d, 1.25::DECIMAL(4,2) AS d4, 1.25::DECIMAL(9,2) AS d9, 1.25::DECIMAL(18,2) AS d18, 1.25::DECIMAL(38,2) AS d38, true AS b, 'x' AS s, 'y'::BLOB AS bl, DATE '2025-01-01' AS dt, TIME '01:02:03' AS t, '01:02:03.123456789'::TIME_NS AS tns, TIMESTAMP_S '2025-01-01 00:00:01' AS tss, TIMESTAMP_MS '2025-01-01 00:00:01.001' AS tsms, TIMESTAMP '2025-01-01 00:00:01.000001' AS ts, TIMESTAMP_NS '2025-01-01 00:00:01.000000001' AS tsns, TIMESTAMPTZ '2025-01-01 00:00:01+00' AS tstz, '2025-01-01 00:00:01.000000001+00'::TIMESTAMPTZ_NS AS tstzns, 'a'::ENUM('a', 'b') AS e, [1, 2] AS l, {'k': 1} AS st, MAP {'a': 1} AS m, [1, 2]::INTEGER[2] AS arr

statement ok
COPY t TO '__TEST_DIR__/t.parquet' (FORMAT tparquet, COLUMN_NAMES ['i8', 'i16', 'i32', 'i64', 'u8', 'u16', 'u32', 'u64', 'f', 'd', 'd4', 'd9', 'd18', 'd38', 'b', 's', 'bl', 'dt', 't', 'tns', 'tss', 'tsms', 'ts', 'tsns', 'tstz', 'tstzns', 'e', 'l', 'st', 'm', 'arr'])

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_tparquet('__TEST_DIR__/t.parquet'))
----
i8	TINYINT
i16	SMALLINT
i32	INTEGER
i64	BIGINT
u8	UTINYINT
u16	USMALLINT
u32	UINTEGER
u64	UBIGINT
f	FLOAT
d	DOUBLE
d4	DECIMAL(4,2)
d9	DECIMAL(9,2)
d18	DECIMAL(18,2)
d38	DECIMAL(38,2)
b	BOOLEAN
s	VARCHAR
bl	BLOB
dt	DATE
t	TIME
tns	TIME_NS
tss	TIMESTAMP_MS
tsms	TIMESTAMP_MS
ts	TIMESTAMP
tsns	TIMESTAMP_NS
tstz	TIMESTAMP WITH TIME ZONE
tstzns	TIMESTAMPTZ_NS
e	VARCHAR
l	INTEGER[]
st	STRUCT(k INTEGER)
m	MAP(VARCHAR, INTEGER)
arr	INTEGER[2]

query TTTTTT
SELECT tns::VARCHAR, tss::VARCHAR, tsns::VARCHAR, tstzns::VARCHAR, e, arr::VARCHAR FROM read_tparquet('__TEST_DIR__/t.parquet')
----
01:02:03.123456789	2025-01-01 00:00:01	2025-01-01 00:00:01.000000001	2025-01-01 00:00:01.000000001+00	a	[1, 2]

query I
SELECT count(*) FROM (SELECT * EXCLUDE (tss, e) FROM t EXCEPT SELECT * EXCLUDE (tss, e) FROM read_tparquet('__TEST_DIR__/t.parquet'))
----
0

statement error
COPY (SELECT 1::HUGEINT AS h) TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['h'])
----
column "h": columns of type HUGEINT cannot be written to Parquet by this extension

statement error
COPY (SELECT [{'u': uuid()}] AS v) TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['v'])
----
column "v": columns of type UUID cannot be written

statement error
COPY (SELECT MAP {'k': INTERVAL 1 DAY} AS v) TO '__TEST_DIR__/x.parquet' (FORMAT tparquet, COLUMN_NAMES ['v'])
----
columns of type INTERVAL cannot be written

# a cast makes them writable
statement ok
COPY (SELECT 1::HUGEINT::DECIMAL(38, 0) AS h, uuid()::VARCHAR AS u, to_months(14)::VARCHAR AS i) TO '__TEST_DIR__/cast.parquet' (FORMAT tparquet, COLUMN_NAMES ['h', 'u', 'i'])

query IT
SELECT h, i FROM read_tparquet('__TEST_DIR__/cast.parquet')
----
1	1 year 2 months

# DuckDB's own Parquet file: INTERVAL keeps its months, NULLs stay NULL
statement ok
COPY (SELECT * FROM (VALUES (INTERVAL '1 year 2 months 3 days'), (NULL)) v(i)) TO '__TEST_DIR__/iv.parquet' (FORMAT parquet)

query T
SELECT i::VARCHAR FROM read_tparquet('__TEST_DIR__/iv.parquet')
----
1 year 2 months 3 days
NULL

# infinities
statement ok
COPY (SELECT 'infinity'::TIMESTAMP_S AS a, '-infinity'::DATE AS b, 'infinity'::TIMESTAMPTZ AS c) TO '__TEST_DIR__/inf.parquet' (FORMAT tparquet, COLUMN_NAMES ['a', 'b', 'c'])

query TTT
SELECT a::VARCHAR, b::VARCHAR, c::VARCHAR FROM read_tparquet('__TEST_DIR__/inf.parquet')
----
infinity	-infinity	infinity
