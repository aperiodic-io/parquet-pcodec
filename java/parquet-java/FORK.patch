+        <artifactId>maven-surefire-plugin</artifactId>
+        <configuration>
+          <dependenciesToScan>
+            <dependency>org.apache.parquet:parquet-hadoop:test-jar:tests:${parquet.upstream.version}</dependency>
+          </dependenciesToScan>
+          <!-- some upstream tests need data or services this suite does not have: compare.py
+               compares outcomes instead of requiring success -->
+          <testFailureIgnore>true</testFailureIgnore>
+          <reportsDirectory>${project.build.directory}/surefire-reports-${parquet.under.test}</reportsDirectory>
+          <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
+          <!-- upstream runs its suite with this heap -->
+          <argLine>-Xmx2g -Djava.library.path=${project.build.directory}/no-native-library -Dorg.slf4j.simpleLogger.defaultLogLevel=warn -Dlog4j.configuration=file:${project.basedir}/log4j-quiet.properties</argLine>
