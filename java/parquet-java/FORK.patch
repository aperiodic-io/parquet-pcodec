+class TestPcodecFiles {
+  static final MessageType SCHEMA = MessageTypeParser.parseMessageType(String.join("\n",
+      "message trades {",
+      "  required int32 i32;",
+      "  required int32 lot;",
+      "  optional int64 i64;",
+      "  required float f32;",
+      "  optional double f64;",
+      "  required double price;",
+      "  required int64 ts (TIMESTAMP(MILLIS,true));",
